---
interface Props { sources: { title: string; url: string }[] }
const { sources } = Astro.props;
---
{sources.length > 0 && (
  <section class="sources" aria-labelledby="src-h">
    <h2 id="src-h">Sources</h2>
    <ol>
      {sources.map((s) => (
        <li><a href={s.url} rel="nofollow noopener" target="_blank">{s.title}</a></li>
      ))}
    </ol>
  </section>
)}
